{{ 'home.css' | asset_url | stylesheet_tag }}
{%- assign section_st = section.settings -%}

<section class="yakchoo-hero scroll-area" data-section-id="{{ section.id }}">
  <div id="yakchoo-intro" class="yakchoo-intro">
    {% if section_st.intro_sky != blank %}
  <img
    class="intro-sky"
    src="{{ section_st.intro_sky | image_url: width: 2500 }}"
    width="{{ section_st.intro_sky.width }}"
    height="{{ section_st.intro_sky.height }}"
    alt="">
{% endif %}
    {% if section_st.intro_logo != blank %}
      <img
        class="intro-logo"
        src="{{ section_st.intro_logo | image_url: width: 1200 }}"
        width="{{ section_st.intro_logo.width }}"
        height="{{ section_st.intro_logo.height }}"
        alt="Yakchoo Logo">
    {% endif %}

    {% if section_st.left_mountain != blank %}
      <img
        class="intro-left"
        src="{{ section_st.left_mountain | image_url: width: 1800 }}"
        width="{{ section_st.left_mountain.width }}"
        height="{{ section_st.left_mountain.height }}"
        alt="">
    {% endif %}

    {% if section_st.right_mountain != blank %}
      <img
        class="intro-right"
        src="{{ section_st.right_mountain | image_url: width: 1800 }}"
        width="{{ section_st.right_mountain.width }}"
        height="{{ section_st.right_mountain.height }}"
        alt="">
    {% endif %}

    {% if section_st.bottom_mountain != blank %}
      <img
        class="intro-bottom"
        src="{{ section_st.bottom_mountain | image_url: width: 2000 }}"
        width="{{ section_st.bottom_mountain.width }}"
        height="{{ section_st.bottom_mountain.height }}"
        alt="">
    {% endif %}

  </div>
  <div
    class="scroll-rotate-section"
    data-wheel-loop="{{ section_st.wheel_loop }}"
    data-wheel-threshold="{{ section_st.wheel_threshold }}"
    data-wheel-lock-time="{{ section_st.wheel_lock_time }}"
    style="{% if section_st.background_image != blank %}
    background-image: url('{{ section_st.background_image | image_url: width: 2048 }}');
     background-size: cover; 
     background-position: center;
      background-repeat: no-repeat;
      {% elsif section_st.background_color != blank %}
      background-color: {{ section_st.background_color }};
      {% endif %}">
    <section class="banner-section">
      <!-- TEXT SLIDER -->
      <div class="banner-content-div" style="text-align: {{ section_st.content_alignment }};">
        <div class="banner-content-wrapper" id="text-slider">
          {% for block in section.blocks %}
            {% if block.type == 'text' %}
              <div class="banner-content">
                <h2 style="color: {{ section_st.heading_color }}; font-size: {{ section_st.heading_size }}px;">{{ block.settings.text }}</h2>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      <a
        class="know-btn"
        href="{{ section_st.button_link | default: '#' }}"
        style="background-color: {{ section_st.button_bg_color }}; color: {{ section_st.button_text_color }};">
        {{ section_st.button_label }}
      </a>

      <!-- PRODUCT WHEEL -->
      <div class="banner-circle-box" style="width: calc(70vh * {{ section_st.product_scale | default: 100 }} / 100); 
      height: calc(70vh * {{ section_st.product_scale | default: 100 }} / 100);
       top: 100%; 
       transform: translate(-50%, -15%) 
       scale(1.3);">
        <div class="banner-circle" data-behavior="banner-circle">
          {% assign default_images = '' | split: ',' %}
          {% for block in section.blocks %}
            {% if block.type == 'product' %}
              {% assign fallback_image = default_images[forloop.index0] %}
              <div class="banner-item">
                {% if block.settings.product_image != blank %}
                  <img
                    src="{{ block.settings.product_image | image_url: width: 900 }}"
                    width="900"
                    height="900"
                    alt="Product image" />
                {% else %}
                  {% if fallback_image != blank %}
                    <img
                      src="{{ fallback_image }}"
                      width="900"
                      height="900"
                      alt="Product image" />
                  {% endif %}
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </section>
  </div>
</section>
<script src="{{ 'home.js' | asset_url }}" defer></script>
{% schema %}
  {
    "name": "Yakchoo Hero Wheel",
    "tag": "section",
    "class": "section",
    "settings": [
      {
        "type": "text",
        "id": "button_label",
        "label": "Button Label",
        "default": "KNOW MORE"
      },
      {
        "type": "url",
        "id": "button_link",
        "label": "Button Link"
      },
      {
        "type": "image_picker",
        "id": "background_image",
        "label": "Background Image"
      },
      {
        "type": "color",
        "id": "background_color",
        "label": "Background Color",
        "default": "#e2f4fc"
      }, {
        "type": "select",
        "id": "content_alignment",
        "label": "Text alignment",
        "options": [
          {
            "value": "left",
            "label": "Left"
          }, {
            "value": "center",
            "label": "Center"
          }, {
            "value": "right",
            "label": "Right"
          }
        ],
        "default": "left"
      }, {
        "type": "color",
        "id": "heading_color",
        "label": "Heading Color",
        "default": "#193d71"
      }, 
       {
        "type": "range",
        "id": "heading_size",
        "label": "Heading Font Size (px)",
        "default": 48,
        "min": 24,
        "max": 80,
        "step": 2,
        "unit": "px"
      }, {
        "type": "color",
        "id": "button_bg_color",
        "label": "Button Background Color",
        "default": "#193d71"
      }, {
        "type": "color",
        "id": "button_text_color",
        "label": "Button Text Color",
        "default": "#fee000"
      }, {
        "type": "checkbox",
        "id": "fit_to_screen",
        "label": "Fit hero to full screen (no overflow)",
        "default": true
      }, {
        "type": "range",
        "id": "product_scale",
        "label": "Product size",
        "min": 60,
        "max": 120,
        "step": 5,
        "unit": "%",
        "default": 100
      }, {
        "type": "checkbox",
        "id": "wheel_loop",
        "label": "Loop wheel when reaching ends",
        "default": false
      }, {
        "type": "range",
        "id": "wheel_threshold",
        "label": "Wheel scroll threshold (px)",
        "default": 160,
        "min": 60,
        "max": 400,
        "step": 10,
        "unit": "px"
      }, {
        "type": "range",
        "id": "wheel_lock_time",
        "label": "Wheel lock time (ms)",
        "default": 650,
        "min": 250,
        "max": 2000,
        "step": 50,
        "unit": "ms"
      },
      {
        "type": "image_picker",
        "id": "intro_sky",
        "label": "Intro Sky"
      },
      {
        "type": "image_picker",
        "id": "intro_logo",
        "label": "Intro Logo"
      }, {
        "type": "image_picker",
        "id": "left_mountain",
        "label": "Left Mountain"
      }, {
        "type": "image_picker",
        "id": "right_mountain",
        "label": "Right Mountain"
      }, {
        "type": "image_picker",
        "id": "bottom_mountain",
        "label": "Bottom Mountain"
      }
    ],
    "blocks": [
      {
        "type": "text",
        "name": "Headline",
        "settings": [
          {
            "type": "text",
            "id": "text",
            "label": "Headline Text",
            "default": "Your Headline Here"
          }
        ]
      }, {
        "type": "product",
        "name": "Product",
        "limit": 3,
        "settings": [
          {
            "type": "image_picker",
            "id": "product_image",
            "label": "Product Image"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Yakchoo Hero Wheel",
        "blocks": [
          {
            "type": "product"
          }, {
            "type": "product"
          }, {
            "type": "product"
          }
        ]
      }
    ]
  }
{% endschema %}