{% liquid
  assign section_st = section.settings
%}

<div class="certification-section">
  <div class="page-width">

    {% if section_st.heading != blank %}
      <h2 class="certification-title" style="
    text-align:{{ section_st.heading_alignment }};
    font-size:{{ section_st.heading_size }}px;
  ">
        {{ section_st.heading }}
      </h2>
    {% endif %}

    {% if section_st.subheading != blank %}
      <p class="certification-subheading">
        {{ section_st.subheading }}
      </p>
    {% endif %}

    <div class="certification-grid">

      {% for block in section.blocks %}

        <div class="certificate-item {% if forloop.index == 4 %}certificate-bottom{% endif %}"
         {{ block.shopify_attributes }}>

          {% if block.settings.image != blank %}
            <img
              src="{{ block.settings.image | image_url: width: 800 }}"
              alt=""
              loading="lazy">
          {% endif %}

        </div>

      {% endfor %}

    </div>

  </div>
</div>

{% schema %}
  {
    "name": "Certification",
    "tag": "section",
    "class": "section-certification",

    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Certifications"
      }, {
        "type": "select",
        "id": "heading_alignment",
        "label": "Heading Alignment",
        "default": "center",
        "options": [
          {
            "value": "left",
            "label": "Left"
          }, {
            "value": "center",
            "label": "Center"
          }, {
            "value": "right",
            "label": "Right"
          }
        ]
      }, {
        "type": "range",
        "id": "heading_size",
        "min": 24,
        "max": 72,
        "step": 2,
        "unit": "px",
        "default": 42,
        "label": "Heading Size"
      }, {
        "type": "text",
        "id": "subheading",
        "label": "Sub Heading",
        "default": "Certified by trusted organizations"
      }
    ],

    "blocks": [
      {
        "type": "certificate",
        "name": "Certificate",
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Certificate Image"
          }
        ]
      }
    ],

    "presets": [
      {
        "name": "Certification"
      }
    ]
  }
{% endschema %}