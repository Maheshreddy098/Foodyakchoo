{%- assign section_st = section.settings -%}

<section class="yakchoo-hero" id="scroll-area">
  <section
    class="scroll-rotate-section"
    style="{% if section_st.background_image != blank %}background-image: url('{{ section_st.background_image | image_url: width: 2048 }}'); background-size: cover; background-position: center; background-repeat: no-repeat;{% elsif section_st.background_color != blank %}background-color: {{ section_st.background_color }};{% endif %}"
    data-wheel-loop="{{ section_st.wheel_loop }}"
    data-wheel-threshold="{{ section_st.wheel_threshold }}"
    data-wheel-lock-time="{{ section_st.wheel_lock_time }}"
  >
    <section class="banner-section">
      <!-- TEXT SLIDER -->
      <div class="banner-content-div" style="text-align: {{ section_st.content_alignment }};">
        <div class="banner-content-wrapper" id="text-slider">
          {% for block in section.blocks %}
            {% if block.type == 'text' %}
              <div class="banner-content">
                <h2 style="color: {{ section_st.heading_color }}; font-size: {{ section_st.heading_size }}px;">{{ block.settings.text }}</h2>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      <a class="know-btn" id="knowMoreBtn" href="{{ section_st.button_link | default: '#' }}" style="background-color: {{ section_st.button_bg_color }}; color: {{ section_st.button_text_color }};">
        {{ section_st.button_label }}
      </a>

      <!-- PRODUCT WHEEL -->
      <div class="banner-circle-box" style="width: calc(70vh * {{ section_st.product_scale | default: 100 }} / 100); height: calc(70vh * {{ section_st.product_scale | default: 100 }} / 100); top: 100%; transform: translate(-50%, -15%) scale(1.3);">
        <div class="banner-circle" id="banner-circle">
          {% for block in section.blocks %}
            {% if block.type == 'product' %}
              <div class="banner-item">
                {% if block.settings.product_image != blank %}
                  <img
                    src="{{ block.settings.product_image | image_url: width: 500 }}"
                    width="500"
                    height="500"
                    alt="Product image"
                  />
                {% else %}
                  <div class="banner-item-placeholder">Upload product image</div>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </section>
  </section>
</section>

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  :root {
    --font-heading: "Bebas Neue", sans-serif;
    --font-body: "Montserrat", sans-serif;
    --color-primary: #193d71;
    --color-accent: #fee000;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    background: repeating-linear-gradient(90deg, #e2f4fc 0, #e2f4fc 110px, #d2eef9 110px, #d2eef9 220px);
    font-family: var(--font-body);
  }

  .yakchoo-hero {
    position: relative;
    width: 100%;
    overflow-x: hidden;
  }

  #scroll-area {
    height: 100vh;
    overflow: hidden;
  }

  .scroll-rotate-section {
    position: relative;
    height: 100%;
    overflow-x: hidden;
  }

  .banner-section {
    position: sticky;
    top: 0;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    display: flex;
    justify-content: flex-start;
    align-items: flex-start;
    flex-direction: column;
    padding: 160px 0 0 0;
  }

  .banner-content-div {
    width: 420px;
    height: 160px;
    overflow: hidden;
    z-index: 10;
    margin-left: 0;
  }

  .banner-content-wrapper {
    display: flex;
    flex-direction: column;
    transition: transform 0.4s ease-out;
  }

  .banner-content {
    height: 160px;
    display: flex;
    align-items: center;
  }

  .banner-content h2 {
    font-family: var(--font-heading);
    font-weight: 600;
    line-height: 1.1;
    max-width: 366px;
    text-transform: uppercase;
    margin: 0;
  }

  .know-btn {
    padding: 15px 28px;
    border-radius: 42px;
    background-color: var(--color-primary);
    font-family: var(--font-heading);
    color: var(--color-accent);
    text-decoration: none;
    font-size: 18px;
    line-height: 1;
    font-weight: 600;
    margin-top: 20px;
    cursor: pointer;
    position: relative;
    z-index: 30;
    transition: all 0.3s ease;
    display: inline-block;
  }

  .know-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(25, 61, 113, 0.2);
  }

  .banner-circle-box {
    position: absolute;
    left: 50%;
    top: 100%;
    transform: translate(-50%, -15%) scale(1.3);
    perspective: 2000px;
    width: calc(70vh * var(--product-scale, 1));
    height: calc(70vh * var(--product-scale, 1));
  }

  .banner-circle {
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 1s ease-out;
  }

  .banner-item {
    width: 80vh;
    height: 80vh;
    border-radius: 50%;
    position: absolute;
    top: 50%;
    left: 50%;
    margin-left: -40vh;
    margin-top: -40vh;
    overflow: hidden;
    transition: transform 1s ease-out;
  }

  .banner-item img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .banner-item-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    background: rgba(0,0,0,0.18);
    font-size: 14px;
    text-align: center;
    padding: 20px;
  }

  @media (max-width: 1024px) {
    .banner-circle-box {
      width: 60vh;
      height: 60vh;
    }

    .banner-item {
      width: 60vh;
      height: 60vh;
      margin-left: -30vh;
      margin-top: -30vh;
    }

    .banner-content h2 {
      font-size: 36px;
      max-width: 300px;
    }
  }

  @media (max-width: 768px) {
    .banner-section {
      padding: 100px 0 0 0;
    }

    .banner-content-div {
      width: 100%;
      height: auto;
      padding: 0 20px;
    }

    .banner-content {
      height: auto;
      min-height: 120px;
    }

    .banner-content h2 {
      font-size: 28px;
      max-width: 100%;
    }

    .know-btn {
      margin-left: 20px;
      margin-top: 15px;
      padding: 12px 24px;
      font-size: 14px;
    }

    .banner-circle-box {
      width: 50vh;
      height: 50vh;
      top: 80%;
      transform: translate(-50%, -50%) scale(1.2);
    }

    .banner-item {
      width: 50vh;
      height: 50vh;
      margin-left: -25vh;
      margin-top: -25vh;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const circle = document.getElementById("banner-circle");
    const items = document.querySelectorAll(".banner-item");
    const textSlider = document.getElementById("text-slider");
    const scrollArea = document.getElementById("scroll-area");
    const sectionEl = document.querySelector('.scroll-rotate-section');

    if (!circle || !items.length || !scrollArea || !textSlider || !sectionEl) return;

    const loopWheel = sectionEl.dataset.wheelLoop === 'true';
    const WHEEL_THRESHOLD = parseInt(sectionEl.dataset.wheelThreshold) || 160;
    const lockTime = parseInt(sectionEl.dataset.wheelLockTime) || 650;


    let current = 0;
    let scrolling = false;

    const total = items.length;
    const angleGap = 360 / total;
    const radius = "-32vh";
    // Keep text static: only show the first heading (no sliding)
    const textSlides = textSlider.querySelectorAll('.banner-content');
    textSlides.forEach((el, i) => {
      el.style.display = i === 0 ? 'flex' : 'none';
    });

    items.forEach((item, i) => {
      item.style.transform = `rotate(${i * angleGap}deg) translateY(${radius})`;
      item.style.transition = "transform 1s cubic-bezier(0.4, 0, 0.2, 1)";
    });

    circle.style.transition = "transform 1s cubic-bezier(0.4, 0, 0.2, 1)";
    textSlider.style.transition = "transform 1s cubic-bezier(0.4, 0, 0.2, 1)";

    function applyRotation() {
      circle.style.transform = `rotate(${-current * angleGap}deg)`;

      items.forEach((item, i) => {
        item.style.opacity = i === current ? "1" : "0";
        item.style.transform = `rotate(${i * angleGap}deg) translateY(${radius}) scale(${i === current ? 1.1 : 0.95})`;
        item.style.zIndex = i === current ? "10" : "1";
      });
    }

    function handleScroll(direction) {
      if (scrolling) return;
      if (!loopWheel && ((current === total - 1 && direction === "down") || (current === 0 && direction === "up"))) {
        return;
      }

      scrolling = true;
      direction === "down" ? current++ : current--;

      if (current < 0) current = loopWheel ? total - 1 : 0;
      if (current >= total) current = loopWheel ? 0 : total - 1;

      applyRotation();

      setTimeout(() => {
        scrolling = false;
      }, lockTime);
    }

    let wheelAccumulated = 0;
    let wheelLocked = false;

    window.addEventListener("wheel", (e) => {
      const rect = scrollArea.getBoundingClientRect();
      // allow handling when section is at least partially in viewport
      if (rect.bottom < 0 || rect.top > window.innerHeight) return;

      if (scrolling || wheelLocked) return;

      const direction = e.deltaY > 0 ? "down" : "up";
      const atEnd = !loopWheel && current === total - 1 && direction === "down";
      const atStart = !loopWheel && current === 0 && direction === "up";

      // If user is trying to scroll past the last/first slide, allow the
      // page to continue to the next section by programmatically scrolling
      // to the next element. This avoids the sticky/overflow preventing
      // native scrolling on some themes.
      if (atStart || atEnd) {
        const scrollToNext = () => {
          try {
            // Scroll the window by one viewport height to reach next section
            window.scrollBy({ top: direction === 'down' ? window.innerHeight : -window.innerHeight, behavior: 'smooth' });
            wheelLocked = true;
            setTimeout(() => { wheelLocked = false; }, lockTime);
          } catch (err) {
            // fallback: let default behavior happen
            return;
          }
        };

        // Let a small delta pass-through trigger the programmatic scroll
        // and do not accumulate wheel deltas here.
        scrollToNext();
        return;
      }

      e.preventDefault();
      wheelAccumulated += e.deltaY;

      if (Math.abs(wheelAccumulated) >= WHEEL_THRESHOLD) {
        handleScroll(direction);
        wheelAccumulated = 0;
        wheelLocked = true;

        setTimeout(() => {
          wheelLocked = false;
        }, lockTime);
      }
    }, { passive: false });

    window.addEventListener("keydown", (e) => {
      const rect = scrollArea.getBoundingClientRect();
      if (rect.bottom < 0 || rect.top > window.innerHeight) return;
      if (scrolling) return;

      if (e.key === "ArrowDown") {
        e.preventDefault();
        handleScroll("down");
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        handleScroll("up");
      }
    }, { passive: false });

    let touchStartY = 0;
    const swipeThreshold = 100;

    scrollArea.addEventListener("touchstart", (e) => {
      touchStartY = e.touches[0].clientY;
    }, { passive: true });

    scrollArea.addEventListener("touchend", (e) => {
      const diff = touchStartY - e.changedTouches[0].clientY;
      if (Math.abs(diff) < swipeThreshold) return;
      const direction = diff > 0 ? "down" : "up";
      if (!loopWheel && ((current === total - 1 && direction === "down") || (current === 0 && direction === "up"))) {
        // When swiping beyond the last/first slide, programmatically
        // scroll to the next/previous section so the page continues.
        const scrollTop = direction === 'down' ? window.innerHeight : -window.innerHeight;
        window.scrollBy({ top: scrollTop, behavior: 'smooth' });
        return;
      }

      handleScroll(direction);
    }, { passive: true });

    applyRotation();
  });
</script>

{% schema %}
{
  "name": "Yakchoo Hero Wheel",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "KNOW MORE"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#e2f4fc"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#193d71"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Font Size (px)",
      "default": 48,
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background Color",
      "default": "#193d71"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#fee000"
    },
    {
      "type": "range",
      "id": "product_scale",
      "label": "Product size",
      "min": 60,
      "max": 120,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "checkbox",
      "id": "wheel_loop",
      "label": "Loop wheel when reaching ends",
      "default": false
    },
    {
      "type": "range",
      "id": "wheel_threshold",
      "label": "Wheel scroll threshold (px)",
      "default": 160,
      "min": 60,
      "max": 400,
      "step": 10,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "wheel_lock_time",
      "label": "Wheel lock time (ms)",
      "default": 650,
      "min": 250,
      "max": 2000,
      "step": 50,
      "unit": "ms"
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Headline",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Headline Text",
          "default": "Your Headline Here"
        }
      ]
    },
    {
      "type": "product",
      "name": "Product",
      "limit": 3,
      "settings": [
        {
          "type": "image_picker",
          "id": "product_image",
          "label": "Product Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Yakchoo Hero Wheel",
      "blocks": [
        { "type": "text", "settings": { "text": "Manifesting Health & Happiness for our Furry Friends" } },
        { "type": "text", "settings": { "text": "Born in the Himalayas, Loved Everywhere" } },
        { "type": "text", "settings": { "text": "Yak Cheese Chews, Made in the Himalayas with Real Yak Milk" } },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}