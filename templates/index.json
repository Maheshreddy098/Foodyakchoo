          "settings": {
            "question": "How can I track my order?",
            "answer": "<p>Once your order ships, you’ll receive a confirmation email with a tracking link. You can click the link to see real-time updates on your shipment. If you haven’t received the email, please check your spam folder or contact our support team.</p>"
          },
          "blocks": {}
        },
        "item_faq_pxVFgz": {
          "type": "_item-faq",
          "settings": {
            "question": "Do you offer gift cards?",
            "answer": "<p>Yes, we offer digital gift cards that can be purchased through our online store. Gift cards are delivered via email and include easy instructions for use. They make the perfect gift for any occasion!</p>"
