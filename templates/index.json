          "settings": {
            "question": "When will I get my money back?",
            "answer": "<p>Refunds are typically processed within 5–10 business days after your return is approved. The exact timing may vary depending on your bank or payment provider. You will receive a confirmation email once your refund has been issued.</p>"
          },
